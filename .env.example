# Copy this file to .env.local and fill in. .env.local is git-ignored (never commit keys).

# ── AI ────────────────────────────────────────────────────────────────
# Leave LLM_BASE_URL / LLM_MODEL empty to use the MOCK AI (no key needed).
# Any OpenAI-compatible endpoint works (Modal, vLLM, OpenAI, OpenRouter...).
# Modal example: LLM_BASE_URL=https://<your-workspace>--<app>.modal.run/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Force mock mode even when the values above are set: AI_MODE=mock
AI_MODE=

# ── Data ──────────────────────────────────────────────────────────────
# Which customer from data/demo/ to show. Empty = MOCK (fake data).
# After `npm run prepare-data`, set e.g. DEMO_CUSTOMER_ID=CUST00001
DEMO_CUSTOMER_ID=

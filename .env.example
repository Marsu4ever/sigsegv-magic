# Copy this file to .env.local and fill in. .env.local is git-ignored (never commit keys).

# ── AI ────────────────────────────────────────────────────────────────
# OpenRouter, FREE models only (see OPENROUTER.md). No key → the MOCK AI is used.
# Get a key at https://openrouter.ai/settings/keys (no credit card, never buy credits).
OPENROUTER_API_KEY=
# Optional. Must be on the free-model allowlist in lib/ai/config.ts, otherwise the chat refuses.
# Empty = the default free model (nvidia/nemotron-3.5-super-vl:free).
# If it's down: OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=
# Optional: make "thinking" models answer faster (e.g. low, none). Only sent if set.
OPENROUTER_REASONING_EFFORT=
# Force mock mode even when the values above are set: AI_MODE=mock
AI_MODE=

# ── Data ──────────────────────────────────────────────────────────────
# Which customer from data/demo/ to show. Empty = MOCK (fake data).
# After `npm run prepare-data`, set e.g. DEMO_CUSTOMER_ID=CUST00001
DEMO_CUSTOMER_ID=

# Copy this file to .env.local and fill in. .env.local is git-ignored (never commit keys).

# ── AI ────────────────────────────────────────────────────────────────
# Leave LLM_BASE_URL / LLM_MODEL empty to use the MOCK AI (no key needed).
# Any endpoint speaking the standard "chat completions" format works (Modal/vLLM, Gemini, Claude, OpenRouter...).
# Modal example: LLM_BASE_URL=https://<your-workspace>--<app>.modal.run/v1
# Gemini example (free tier, no card): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<key from aistudio.google.com>  LLM_MODEL=gemini-3.7-flash
#   (tested 14 Nov: gemini-3.7-flash and gemini-3.5-flash work; 3.8-flash and flash-latest hang, 2.5-flash gives 404)
# Claude example (temporary, until Modal): LLM_BASE_URL=https://api.anthropic.com/v1/
#   LLM_API_KEY=<Claude API key from platform.claude.com>  LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: make "thinking" models answer faster (e.g. low, none). Only sent if set.
LLM_REASONING_EFFORT=
# Force mock mode even when the values above are set: AI_MODE=mock
AI_MODE=

# ── Data ──────────────────────────────────────────────────────────────
# Which customer from data/demo/ to show. Empty = MOCK (fake data).
# After `npm run prepare-data`, set e.g. DEMO_CUSTOMER_ID=CUST00001
DEMO_CUSTOMER_ID=
